bluez-alsa 5.0.0 with alsa-lib older than 1.1.6 (the PlayStation Classic has 1.1.2): the ALSA
PCM plugin calls snd_pcm_ioplug_avail() and snd_pcm_areas_copy_wrap(), which those versions
lack, and modifies a const hw_ptr where alsa-lib has no SND_PCM_IOPLUG_FLAG_BOUNDARY_WA.
Fallbacks next to the existing snd_pcm_ioplug_hw_avail() one; nothing changes on newer ALSA.

--- a/src/asound/bluealsa-pcm.c	2026-11-19 13:31:44
+++ b/src/asound/bluealsa-pcm.c	2026-11-19 13:31:44
@@ -165,6 +165,43 @@
 		diff += pcm->io_hw_boundary;
 	snd_pcm_uframes_t diff_ = diff;
 	return diff_ <= io->buffer_size ? diff_ : 0;
+}
+
+/**
+ * Get the frames the application can transfer.
+ *
+ * Also available in alsa-lib since version 1.1.6 only. */
+static snd_pcm_uframes_t snd_pcm_ioplug_avail(const snd_pcm_ioplug_t * const io,
+		const snd_pcm_uframes_t hw_ptr, const snd_pcm_uframes_t appl_ptr) {
+	return io->buffer_size - snd_pcm_ioplug_hw_avail(io, hw_ptr, appl_ptr);
+}
+
+/**
+ * Copy areas, wrapping around the end of both buffers.
+ *
+ * Also available in alsa-lib since version 1.1.6 only (same algorithm). */
+static int snd_pcm_areas_copy_wrap(const snd_pcm_channel_area_t *dst_channels,
+		snd_pcm_uframes_t dst_offset, const snd_pcm_uframes_t dst_size,
+		const snd_pcm_channel_area_t *src_channels, snd_pcm_uframes_t src_offset,
+		const snd_pcm_uframes_t src_size, const unsigned int channels,
+		snd_pcm_uframes_t frames, const snd_pcm_format_t format) {
+	while (frames > 0) {
+		snd_pcm_uframes_t xfer = frames;
+		int err;
+		if (dst_offset + xfer > dst_size)
+			xfer = dst_size - dst_offset;
+		if (src_offset + xfer > src_size)
+			xfer = src_size - src_offset;
+		if ((err = snd_pcm_areas_copy(dst_channels, dst_offset, src_channels,
+						src_offset, channels, xfer, format)) < 0)
+			return err;
+		if ((dst_offset += xfer) >= dst_size)
+			dst_offset = 0;
+		if ((src_offset += xfer) >= src_size)
+			src_offset = 0;
+		frames -= xfer;
+	}
+	return 0;
 }
 #endif
 
@@ -701,7 +738,12 @@
 		snd_pcm_ioplug_set_state(io, SND_PCM_STATE_DISCONNECTED);
 
 	/* Get the snapshot of the atomic pointer. */
+#ifdef SND_PCM_IOPLUG_FLAG_BOUNDARY_WA
 	const snd_pcm_sframes_t hw_ptr = pcm->io_hw_ptr;
+#else
+	/* alsa-lib < 1.1.6: the pointer is reduced to the buffer below */
+	snd_pcm_sframes_t hw_ptr = pcm->io_hw_ptr;
+#endif
 
 #ifndef SND_PCM_IOPLUG_FLAG_BOUNDARY_WA
 	if (hw_ptr != -1)
