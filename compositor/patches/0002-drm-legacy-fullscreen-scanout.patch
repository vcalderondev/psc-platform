diff -ruN a/libweston/compositor-drm.c b/libweston/compositor-drm.c
--- a/libweston/compositor-drm.c	2026-11-14 09:40:03
+++ b/libweston/compositor-drm.c	2026-11-14 09:40:03
@@ -323,6 +323,10 @@
 	struct wl_list plane_list;
 	int sprites_are_broken;
 	int sprites_hidden;
+	/* PSC: non-atomic KMS (see init_kms_caps), but a fullscreen client buffer may
+	 * still be promoted to the primary plane with drmModePageFlip, skipping the GL
+	 * composition pass. Overlay planes stay disabled. */
+	bool legacy_scanout;
 
 	void *repaint_data;
 
@@ -2017,9 +2021,21 @@
 	struct drm_fb *fb;
 	pixman_box32_t *extents;
 
-	assert(!b->sprites_are_broken);
+	assert(!b->sprites_are_broken || b->legacy_scanout);
 	assert(mode == DRM_OUTPUT_PROPOSE_STATE_PLANES_ONLY);
 
+	/* Legacy KMS can only test a client buffer by showing it. Never let one reach
+	 * drmModeSetCrtc: scan out only when a renderer frame is already on screen, no
+	 * modeset is pending, and the client's stride matches it, so the only call that
+	 * ever sees a client buffer is drmModePageFlip, which on failure leaves the
+	 * current frame on screen (see drm_output_apply_state_legacy). */
+	if (b->sprites_are_broken &&
+	    (b->state_invalid || !scanout_plane->state_cur->fb)) {
+		drm_debug(b, "\t\t\t\t[scanout] not placing view %p on scanout: "
+			     "legacy, no frame on screen yet\n", ev);
+		return NULL;
+	}
+
 	/* Check the view spans exactly the output size, calculated in the
 	 * logical co-ordinate space. */
 	extents = pixman_region32_extents(&ev->transform.boundingbox);
@@ -2045,10 +2061,22 @@
 
 	/* Can't change formats with just a pageflip */
 	if (!b->atomic_modeset && fb->format->format != output->gbm_format) {
+		drm_debug(b, "\t\t\t\t[scanout] not placing view %p on scanout: "
+			     "format differs from the output's\n", ev);
 		drm_fb_unref(fb);
 		return NULL;
 	}
 
+	/* A different stride would need drmModeSetCrtc (see above) */
+	if (b->sprites_are_broken &&
+	    fb->strides[0] != scanout_plane->state_cur->fb->strides[0]) {
+		drm_debug(b, "\t\t\t\t[scanout] not placing view %p on scanout: "
+			     "legacy, stride %u differs from the current %u\n", ev,
+			     fb->strides[0], scanout_plane->state_cur->fb->strides[0]);
+		drm_fb_unref(fb);
+		return NULL;
+	}
+
 	state = drm_output_state_get_plane(output_state, scanout_plane);
 
 	/* The only way we can already have a buffer in the scanout plane is
@@ -2354,6 +2382,26 @@
 			    scanout_state->fb->fb_id,
 			    DRM_MODE_PAGE_FLIP_EVENT, output) < 0) {
 		weston_log("queueing pageflip failed: %s\n", strerror(errno));
+		if (backend->legacy_scanout &&
+		    scanout_state->fb->type != BUFFER_GBM_SURFACE &&
+		    scanout_state->fb->type != BUFFER_PIXMAN_DUMB) {
+			/* The kernel refused a client buffer (wl_buffer or dmabuf
+			 * import, i.e. not the renderer's): nothing changed on
+			 * screen (a legacy flip is all or nothing, and no SetCrtc was
+			 * made with it, see prepare_scanout_view). Stop trying for
+			 * this session and finish the frame, so the next repaint is
+			 * composited by GL instead of waiting for a flip that will
+			 * never come. */
+			weston_log("DRM: legacy scanout of a client buffer refused, "
+				   "disabled for this session\n");
+			backend->legacy_scanout = false;
+			output->cursor_view = NULL;
+			drm_output_state_free(state);
+			weston_output_damage(&output->base);
+			weston_output_finish_frame(&output->base, NULL,
+						   WP_PRESENTATION_FEEDBACK_INVALID);
+			return 0;
+		}
 		goto err;
 	}
 
@@ -3237,7 +3283,9 @@
 		PLACED_ON_PLANE,
 	} availability = NO_PLANES;
 
-	assert(!b->sprites_are_broken);
+	/* legacy_scanout: the primary plane only, never legacy SetPlane overlays */
+	if (b->sprites_are_broken)
+		return NULL;
 
 	fb = drm_fb_get_from_view(output_state, ev);
 	if (!fb) {
@@ -3873,6 +3921,17 @@
 			drm_debug(b, "\t[repaint] could not build mixed-mode "
 				     "state, trying renderer-only\n");
 		}
+	} else if (b->legacy_scanout && !output->virtual) {
+		/* Legacy KMS: only the scanout plane (and the cursor) can be used.
+		 * PLANES_ONLY succeeds only when the topmost view covers the whole
+		 * output and can be page-flipped as is, every other view occluded;
+		 * drm_pending_state_test() is a no-op on legacy, so all the checks
+		 * are in drm_output_prepare_scanout_view(). */
+		drm_debug(b, "\t[repaint] legacy: trying scanout-only state\n");
+		state = drm_output_propose_state(output_base, pending_state, mode);
+		if (!state)
+			drm_debug(b, "\t[repaint] legacy scanout not possible, "
+				     "renderer-only\n");
 	} else {
 		drm_debug(b, "\t[state] no overlay plane support\n");
 	}
@@ -4191,7 +4250,16 @@
 	 */
 	if (!b->atomic_modeset || getenv("WESTON_FORCE_RENDERER"))
 		b->sprites_are_broken = 1;
+
+	/* PSC: kernel 4.4 lacks DRM_CAP_CRTC_IN_VBLANK_EVENT (4.12), so atomic is off
+	 * even though the MediaTek driver is atomic; allow fullscreen scanout anyway
+	 * when asked (WESTON_LEGACY_SCANOUT=1). */
+	b->legacy_scanout = !b->atomic_modeset &&
+			    !getenv("WESTON_FORCE_RENDERER") &&
+			    getenv("WESTON_LEGACY_SCANOUT") != NULL;
+	weston_log("DRM: legacy fullscreen scanout %s\n",
+		   b->legacy_scanout ? "enabled" : "disabled");
 
 	ret = drmSetClientCap(b->drm.fd, DRM_CLIENT_CAP_ASPECT_RATIO, 1);
 	b->aspect_ratio_supported = (ret == 0);
