  * @param drm_device udev device pointer
  * @returns The new head, or NULL on failure.
  */
+/* PSC: the MediaTek kernel (a 4.4 vendor tree) lists a writeback connector, type 18,
+ * in every GETRESOURCES (it has no DRM_CLIENT_CAP_WRITEBACK_CONNECTORS to hide it).
+ * It is not a display: never make a head for it (it would show up as "UNNAMED-1"). */
+static bool
+drm_connector_is_writeback(struct drm_backend *b, uint32_t connector_id)
+{
+	drmModeConnector *c = drmModeGetConnector(b->drm.fd, connector_id);
+	bool wb = c && c->connector_type == 18; /* DRM_MODE_CONNECTOR_WRITEBACK */
+
+	drmModeFreeConnector(c);
+	return wb;
+}
+
 static struct drm_head *
 drm_head_create(struct drm_backend *backend, uint32_t connector_id,
 		struct udev_device *drm_device)
