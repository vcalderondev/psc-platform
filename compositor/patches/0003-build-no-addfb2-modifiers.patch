diff -ruN a/libweston/meson.build b/libweston/meson.build
--- a/libweston/meson.build	2026-11-14 04:16:09
+++ b/libweston/meson.build	2026-11-14 04:16:10
@@ -222,7 +222,10 @@
 		config_h.set('BUILD_VAAPI_RECORDER', '1')
 	endif
 
-	if dep_libdrm.version().version_compare('>= 2.4.71')
+	# PSC: the console's libdrm (2.4.66-2.4.70 era) has no drmModeAddFB2WithModifiers;
+	# Weston loads drm-backend.so with RTLD_NOW, so the call must not be compiled in
+	# even when the build headers are newer.
+	if dep_libdrm.version().version_compare('>= 2.4.71') and not get_option('psc-no-addfb2-modifiers')
 		config_h.set('HAVE_DRM_ADDFB2_MODIFIERS', '1')
 	endif
 
diff -ruN a/meson_options.txt b/meson_options.txt
--- a/meson_options.txt	2026-11-14 04:16:09
+++ b/meson_options.txt	2026-11-14 04:16:10
@@ -204,3 +204,9 @@
 	value: true,
 	description: 'Tests: output JUnit XML results'
 )
+option(
+	'psc-no-addfb2-modifiers',
+	type: 'boolean',
+	value: true,
+	description: 'PlayStation Classic: never call drmModeAddFB2WithModifiers (missing from the console libdrm)'
+)
