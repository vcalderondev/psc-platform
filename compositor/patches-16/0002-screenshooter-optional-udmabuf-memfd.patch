PSC: build weston-screenshooter (shared/client-buffer-util.c) against
kernel 4.9 uapi headers and glibc 2.24: linux/dma-buf.h (4.11),
linux/udmabuf.h (4.20) and memfd_create()/MFD_ALLOW_SEALING (glibc 2.27)
are optional. Without them the screenshooter has no dmabuf (udmabuf) client
buffers, reports "udmabuf not supported" and uses shm.

diff --git a/meson.build b/meson.build
index 361d132..df78fca 100644
--- a/meson.build
+++ b/meson.build
@@ -96,7 +96,9 @@ foreach func : optional_libc_funcs
 endforeach
 
 optional_system_headers = [
-	'linux/sync_file.h'
+	'linux/sync_file.h',
+	'linux/dma-buf.h',
+	'linux/udmabuf.h',
 ]
 foreach hdr : optional_system_headers
 	if cc.has_header(hdr)
diff --git a/shared/client-buffer-util.c b/shared/client-buffer-util.c
index 067cf9f..0657dc6 100644
--- a/shared/client-buffer-util.c
+++ b/shared/client-buffer-util.c
@@ -28,8 +28,12 @@
 #include "client-buffer-util.h"
 
 #include <fcntl.h>
+#ifdef HAVE_LINUX_DMA_BUF_H
 #include <linux/dma-buf.h>
+#endif
+#ifdef HAVE_LINUX_UDMABUF_H
 #include <linux/udmabuf.h>
+#endif
 #include <sys/ioctl.h>
 #include <sys/mman.h>
 #include <wayland-client.h>
@@ -194,9 +198,19 @@ client_buffer_util_fill_buffer_args(struct client_buffer *buf,
 	return true;
 }
 
+/* PSC: dmabuf client buffers need kernel 4.20 uapi headers (dma-buf.h,
+ * udmabuf.h) and glibc 2.27 (memfd_create); without them there are none */
+#if defined(HAVE_LINUX_DMA_BUF_H) && defined(HAVE_LINUX_UDMABUF_H) && \
+    defined(HAVE_MEMFD_CREATE)
+#define HAVE_UDMABUF 1
+#endif
+
 bool
 client_buffer_util_is_dmabuf_supported(void)
 {
+#ifndef HAVE_UDMABUF
+	return false;
+#else
 	int udmabuf_fd;
 
 	udmabuf_fd = open (UDMABUF_PATH, O_RDWR | O_CLOEXEC, 0);
@@ -205,6 +219,7 @@ client_buffer_util_is_dmabuf_supported(void)
 
 	close(udmabuf_fd);
 	return true;
+#endif
 }
 
 void
@@ -312,6 +327,11 @@ client_buffer_util_create_dmabuf_buffer(struct wl_display *display,
 					int width,
 					int height)
 {
+#ifndef HAVE_UDMABUF
+	(void)params_listener;
+	fprintf(stderr, "udmabuf not supported\n");
+	return NULL;
+#else
 	struct client_buffer *buf;
 	struct buffer_create_data create_data = { 0 };
 	struct zwp_linux_buffer_params_v1 *params;
@@ -422,11 +442,15 @@ error:
 		close(mem_fd);
 	client_buffer_util_destroy_buffer(buf);
 	return NULL;
+#endif
 }
 
 void
 client_buffer_util_maybe_sync_dmabuf_start(struct client_buffer *buf)
 {
+#ifndef HAVE_UDMABUF
+	(void)buf;	/* no dmabuf buffers without udmabuf */
+#else
 	struct dma_buf_sync sync = { DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ | DMA_BUF_SYNC_WRITE };
 	int ret;
 
@@ -436,11 +460,15 @@ client_buffer_util_maybe_sync_dmabuf_start(struct client_buffer *buf)
 	do {
 		ret = ioctl(buf->dmabuf_fd, DMA_BUF_IOCTL_SYNC, &sync);
 	} while (ret && (errno == EINTR || errno == EAGAIN));
+#endif
 }
 
 void
 client_buffer_util_maybe_sync_dmabuf_end(struct client_buffer *buf)
 {
+#ifndef HAVE_UDMABUF
+	(void)buf;	/* no dmabuf buffers without udmabuf */
+#else
 	struct dma_buf_sync sync = { DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ | DMA_BUF_SYNC_WRITE };
 	int ret;
 
@@ -450,4 +478,5 @@ client_buffer_util_maybe_sync_dmabuf_end(struct client_buffer *buf)
 	do {
 		ret = ioctl(buf->dmabuf_fd, DMA_BUF_IOCTL_SYNC, &sync);
 	} while (ret && (errno == EINTR || errno == EAGAIN));
+#endif
 }
