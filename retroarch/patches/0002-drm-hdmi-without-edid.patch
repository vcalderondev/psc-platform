+/* PSC (MediaTek MT8167) fallback: the HDMI DDC/EDID read fails on the
+ * PlayStation Classic, so the connector reports no modes (and may not report
+ * "connected"). Weston works around it with a forced 1280x720 mode in
+ * weston.ini; do the same: CEA-861 VIC 4, 1280x720@60, 74.25 MHz. */
+static void drm_fill_cea_720p60(drmModeModeInfo *m)
+{
+   memset(m, 0, sizeof(*m));
+   m->clock       = 74250;
+   m->hdisplay    = 1280;
+   m->hsync_start = 1390;
+   m->hsync_end   = 1430;
+   m->htotal      = 1650;
+   m->vdisplay    = 720;
+   m->vsync_start = 725;
+   m->vsync_end   = 730;
+   m->vtotal      = 750;
+   m->vrefresh    = 60;
+   m->flags       = DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_PVSYNC;
+   m->type        = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+   strlcpy(m->name, "1280x720", sizeof(m->name));
+}
+
+static bool drm_get_fallback_connector(int fd)
+{
+   unsigned i;
+   for (i = 0; (int)i < g_drm_resources->count_connectors; i++)
+   {
+      drmModeConnectorPtr conn = drmModeGetConnector(fd,
+            g_drm_resources->connectors[i]);
+      if (!conn)
+         continue;
+      if (     conn->connector_type == DRM_MODE_CONNECTOR_HDMIA
+            || conn->connector_type == DRM_MODE_CONNECTOR_HDMIB
+            || conn->connector_type == DRM_MODE_CONNECTOR_DVID)
+      {
+         if (conn->count_modes == 0)
+         {
+            drmModeModeInfo *mode = (drmModeModeInfo*)calloc(1, sizeof(*mode));
+            if (!mode)
+            {
+               drmModeFreeConnector(conn);
+               return false;
+            }
+            drm_fill_cea_720p60(mode);
+            /* libdrm frees conn->modes with drmFree() == free() */
+            free(conn->modes);
+            conn->modes       = mode;
+            conn->count_modes = 1;
+            RARCH_WARN("[DRM] Connector %d (HDMI) reports no modes (EDID unreadable?): "
+                  "using fallback 1280x720@60.\n", i);
+         }
+         RARCH_WARN("[DRM] Using HDMI connector %d as fallback (connection state %d).\n",
+               i, conn->connection);
+         g_drm_connector = conn;
+         return true;
+      }
+      drmModeFreeConnector(conn);
+   }
+   return false;
+}
